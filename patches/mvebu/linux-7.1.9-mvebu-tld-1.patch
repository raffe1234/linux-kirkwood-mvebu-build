+
+/dts-v1/;
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include "armada-385.dtsi"
+
+/ {
+	model = "Synology DS216";
+	compatible = "synology,ds216", "marvell,armada385";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x00000000 0x20000000>; // 512MB
+	};
+
+	soc {
+		ranges = <MBUS_ID(0xf0, 0x01) 0 0xf1000000 0x100000
+			  MBUS_ID(0x01, 0x1d) 0 0xfff00000 0x100000
+			  MBUS_ID(0x09, 0x19) 0 0xf1100000 0x10000
+			  MBUS_ID(0x09, 0x15) 0 0xf1110000 0x10000
+			  MBUS_ID(0x0c, 0x04) 0 0xf1200000 0x100000>;
+		
+		internal-regs {
+			/* A PIC16F1829 is connected to uart1 at 9600 bps,
+			* and takes single-character orders :
+			*   "1" : power off // already handled by the poweroff node
+			*   "2" : short beep
+			*   "3" : long beep
+			*   "4" : turn the power LED ON
+			*   "5" : flash the power LED
+			*   "6" : turn the power LED OFF
+			*   "7" : turn the status LED OFF
+			*   "8" : turn the status LED ON
+			*   "9" : flash the status LED
+			*   "A" : flash the motherboard LED
+			*   "B" : turn the motherboard LED OFF
+			*   "C" : hard reset
+			*
+			* More commands do exist. For example some are related to fan
+			* control, others can schedule boot. Details could probably be
+			* found somewhere in the Synology GPL tarballs.
+			*/
+			poweroff@12100 {
+				compatible = "synology,power-off";
+				reg = <0x12100 0x100>;
+				clocks = <&coreclk 0>;
+			};
+		};
+	};
+
+    ehci_phy: ehci-phy {
+		compatible = "usb-nop-xceiv";
+		vcc-supply = <&reg_ehci_vbus0>;
+		 #phy-cells = <0>;
+	};
+
+    xhci_phy: xhci-phy {
+		compatible = "usb-nop-xceiv";
+		vcc-supply = <&reg_xhci_vbus0>;
+		 #phy-cells = <0>;
+	};
+
+    keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&pmx_copy_button>;
+		pinctrl-names = "default";
+
+		button-0 {
+			label = "copy-button";
+			linux,code = <KEY_COPY>;
+			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+    leds {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&pmx_enable_all_leds
+					&pmx_enable_disk_leds
+					&pmx_enable_phy_led
+					&pmx_disk1_orange_led
+					&pmx_disk2_orange_led>;
+
+		pinctrl-names = "default";
+
+		/* Dummy LED that controls all light sources */
+		led-0 {
+			function = "enable-all";
+			color = <LED_COLOR_ID_MULTI>;
+			default-state = "on";
+			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
+		};
+
+		/* Dummy LED that controls all disk light sources */
+		led-1 {
+			function = "enable-disk";
+			color = <LED_COLOR_ID_MULTI>;
+			default-state = "on";
+			gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-2 {
+			function = LED_FUNCTION_LAN;
+			color = <LED_COLOR_ID_GREEN>;
+			default-state = "on";
+			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
+		};
+
+		/*
+		 * Enabling any of the following orange LEDs will disable
+		 * the green disk activity LED it shares the indicator with.
+		 */
+		led-3 {
+			function = LED_FUNCTION_DISK_ERR;
+			color = <LED_COLOR_ID_AMBER>;
+			function-enumerator = <1>;
+			default-state = "off";
+			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-4 {
+			function = LED_FUNCTION_DISK_ERR;
+			color = <LED_COLOR_ID_AMBER>;
+			function-enumerator = <2>;
+			default-state = "off";
+			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+    fan {
+		compatible = "gpio-fan";
+	    gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>,
+			    <&gpio1 5 GPIO_ACTIVE_HIGH>,
+			    <&gpio0 15 GPIO_ACTIVE_HIGH>;
+		gpio-fan,speed-map = <   0 0
+					      1500 1
+					      2500 2
+					      3000 3
+					      3400 4
+					      3700 5
+					      3900 6
+					      4000 7>;
+		#cooling-cells = <2>;
+	};
+	
+    reg_ehci_vbus0: ehci-vbus0 {
+		compatible = "regulator-fixed";
+		regulator-name = "ehci-vbus0";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		gpio = <&gpio1 15 GPIO_ACTIVE_HIGH>;
+	};
+
+    reg_xhci_vbus0: xhci-vbus0 {
+		compatible = "regulator-fixed";
+		regulator-name = "xhci-vbus0";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		gpio = <&gpio1 12 GPIO_ACTIVE_HIGH>;
+	};
+
+	reg_sata0: pwr-sata0 {
+		compatible = "regulator-fixed";
+		regulator-name = "pwr_en_sata0";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		gpio = <&gpio0 26 GPIO_ACTIVE_HIGH>;
+	};
+
+	reg_5v_sata0: v5-sata0 {
+		compatible = "regulator-fixed";
+		regulator-name = "v5.0-sata0";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_sata0>;
+	};
+
+	reg_12v_sata0: v12-sata0 {
+		compatible = "regulator-fixed";
+		regulator-name = "v12.0-sata0";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		vin-supply = <&reg_sata0>;
+	};
+
+	reg_sata1: pwr-sata1 {
+		regulator-name = "pwr_en_sata1";
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+		gpio = <&gpio0 27 GPIO_ACTIVE_HIGH>;
+	};
+
+	reg_5v_sata1: v5-sata1 {
+		compatible = "regulator-fixed";
+		regulator-name = "v5.0-sata1";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_sata1>;
+	};
+
+	reg_12v_sata1: v12-sata1 {
+		compatible = "regulator-fixed";
+		regulator-name = "v12.0-sata1";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		vin-supply = <&reg_sata1>;
+	};
+};
+
+&ahci0 {
+	status = "okay";
+};
+
+&bm {
+	status = "okay";
+};
+
+&bm_bppi {
+	status = "okay";
+};
+
+&eth0 {
+	status = "okay";
+	phy = <&phy0>;
+	phy-mode = "sgmii";
+	buffer-manager = <&bm>;
+	bm,pool-long = <0>;
+	bm,pool-short = <1>;
+};
+
+&mdio {
+	phy0: ethernet-phy@1 {
+		reg = <1>;
+	};
+};
+
+&gpio0 {
+	gpio-line-names = "", "", "", "", "", "", "Copy button", "",
+					  "", "Enable disk LEDs", "", "", "Model ID 0", "Disk1 fault LED", "Disk2 fault LED", "Fan high",
+					  "Enable PHY LED", "", "", "", "", "Model ID 1", "", "",
+					  "", "", "Enable disk1 power", "Enable disk2 power", "", "", "", "";
+};
+
+&gpio1 {
+	gpio-line-names = "", "", "", "", "", "Fan mid", "Fan low", "Disk1 absent",
+					  "Disk2 absent", "XHCI overcurrent", "Enable all LEDs", "EHCI overcurrent", "Enable XHCI power", "Model ID 2", "SD card detect", "Enable EHCI power",
+					  "", "", "", "", "", "", "", "",
+					  "", "", "", "", "", "", "", "";
+};
+
+&pinctrl {
+	pinctrl-names = "default";
+
+    /* use only one pin for UART1, as mpp20 is used by sata0 */
+	uart1_pins: uart-pins-1 {
+		marvell,pins = "mpp19";
+		marvell,function = "ua1";
+	};
+    
+    pmx_model_id0: pmx-model-id0 {
+		marvell,pins = "mpp12";
+		marvell,function = "gpio";
+	};
+
+    pmx_model_id1: pmx-model-id1 {
+		marvell,pins = "mpp21";
+		marvell,function = "gpio";
+	};
+
+    pmx_model_id2: pmx-model-id2 {
+		marvell,pins = "mpp45";
+		marvell,function = "gpio";
+	};
+
+    pmx_disk1_present: pmx-disk1-present {
+		marvell,pins = "mpp39";
+		marvell,function = "gpio";
+	};
+    
+    pmx_disk2_present: pmx-disk2-present {
+		marvell,pins = "mpp40";
+		marvell,function = "gpio";
+	};
+
+    pmx_ehci_overcurrent: pmx-ehci-overcurrent {
+		marvell,pins = "mpp43";
+		marvell,function = "gpio";
+	};
+
+    pmx_xhci_overcurrent: pmx-xhci-overcurrent {
+		marvell,pins = "mpp41";
+		marvell,function = "gpio";
+	};
+
+	pmx_copy_button: pmx-copy-button {
+		marvell,pins = "mpp6";
+		marvell,function = "gpio";
+	};
+
+    pmx_enable_all_leds: pmx-enable-all-leds {
+		marvell,pins = "mpp42";
+		marvell,function = "gpio";
+	};
+
+    pmx_enable_disk_leds: pmx-enable-disk-leds {
+		marvell,pins = "mpp9";
+		marvell,function = "gpio";
+	};
+
+    pmx_enable_phy_led: pmx-enable-phy-led {
+		marvell,pins = "mpp16";
+		marvell,function = "gpio";
+	};
+
+    pmx_disk1_orange_led: pmx-disk1-orange-led {
+		marvell,pins = "mpp13";
+		marvell,function = "gpio";
+	};
+
+    pmx_disk2_orange_led: pmx-disk2-orange-led {
+		marvell,pins = "mpp14";
+		marvell,function = "gpio";
+	};
+};
