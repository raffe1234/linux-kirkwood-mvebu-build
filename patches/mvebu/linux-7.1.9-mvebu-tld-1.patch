+			regulator-name = "lcd-power";
+			regulator-min-microvolt = <3300000>;
+			regulator-max-microvolt = <3300000>;
+			enable-active-high;
+                        regulator-boot-on;
+			gpio = <&gpio0 11 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+};
+                        
+&pinctrl {
+
+	compatible = "marvell,dove-pinctrl";
+	reg = <0x0200 0x14>,
+	<0x0440 0x04>;
+	clocks = <&gate_clk 22>;
+
+	pinctrl-names = "default";
