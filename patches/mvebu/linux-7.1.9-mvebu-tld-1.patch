+	lcd_pwr: pmx-lcd-pwr {
+                marvell,pins = "mpp11";
+                marvell,function = "gpio";
+        };
+
+	pmx_pwr_off: pmx-pwr-off {
+		marvell,pins = "mpp8";
+		marvell,function = "gpio";
+	};
+
+	pmx_sdio0_gpio: pmx-sdio0-gpio {
+		marvell,pins = "mpp_sdio0";
+		marvell,function = "gpio";
+	};
+
+        pmx_audio_rst: pmx-audio-rst {
+                marvell,pins = "mpp55";
+                marvell,function = "gpio";
+        };
+
+	mcu_intrn: mcu_intrn {
+		marvell,pins = "mpp0";
+		marvell,function = "gpio";
+	};
+
+	i2s_codec_irq: i2s-codec-irq {
+		marvell,pins = "mpp1";
+		marvell,function = "gpio";
+	};
+
+	hub_resetn: hub_resetn {
+		marvell,pins = "mpp9";
+		marvell,function = "gpio";
+	};
+
+	ddr_term: ddr-term {
+		marvell,pins = "mpp16";
+		marvell,function = "gpio";
+	};
+
+};
+
+&uart0 {
+	status = "okay"; 
+};
+
+&uart1 {
+	status = "okay"; 
+};
+
+&sdio0 {
+        pinctrl-0 = <&pmx_sdio0_gpio>;
+        pinctrl-names = "default";
+        status = "okay";
+        gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
+	status = "okay"; 
+};
+
+&sdio1 {
+        status = "okay";
+};
+
+&sata0 {
+	status = "okay"; };
+
+&spi0 {
+	status = "okay";
+
+	/* spi0.0 */
+	spi-flash@0 {
+		compatible = "stt,sst25vf080b", "jedec,spi-nor";
+		spi-max-frequency = <16000000>;
+		reg = <0>;
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+		alc5621: alc5621@1a {
+			compatible = "realtek,alc5621";
+			reg = <0x1a>;
+			#sound-dai-cells = <0>;
+			add-ctrl = <0x3700>;
+			jack-det-ctrl = <0x4810>;
+		};
+};
+
+&pcie {
+	status = "okay";
+		
+	pcie0: pcie@1 {
+		status = "okay";
+	};
+		
+	pcie1: pcie@2 {
+		status = "okay";
+	};
+};
+
+&lcd1 {
+	pinctrl-0 = <&lcd_pwr>;
+	pinctrl-names = "default";
+	gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
+
+&lcd0 {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&audio0 {
+	status = "okay";
+        #sound-dai-cells = <1>;
+};
+
+&mdio {
+	status = "okay";
+	ethphy: ethernet-phy@1 {
+		reg = <1>;
+	};
+};
+
+&eth {
+	status = "okay";
+	ethernet-port@0 {
+		phy-handle = <&ethphy>;
+	};
+};
+
